# /etc/mari-gate.conf (sourced by mari-gate)
RUNNER_PREFIX=runner-          # containers are <prefix>1 .. <prefix><POOL_SIZE>
POOL_SIZE=10
CAP=6                          # at most this many runner containers online
LOAD_MAX=8                     # park idle runners while the host 1-minute load is at or above this
HIGH_TICKS=1                   # ...on this many timer ticks in a row (2 = ignore a single-sample spike)
HOLD_S=120                     # wait this long after the last park before unparking
LAUNCH_CMD=/usr/local/sbin/run-runners.sh   # called as: LAUNCH_CMD <index>
MODE=observe                   # observe first; switch to enforce when the log looks right
OTHER_JOB_PREFIX=              # optional: containers of another runner pool on this host (name prefix);
                               # each counts against CAP as one job, so CAP = jobs on the host
FAIL_ALERT=10                  # consecutive failed unparks before ALERT_CMD runs (then every 12x that)
ALERT_CMD=                     # optional: called with one message argument, e.g. a notify script
LOAD_PARK=1                    # 0 = high load only holds (no park, no unpark): parking an online runner can kill a job
EMERGENCY_LOAD=0               # with LOAD_PARK=0: park anyway when load1 >= this (0 = never) ...
EMERGENCY_TICKS=10             # ... for this many ticks in a row ...
EMERGENCY_PSI=30               # ... and CPU pressure 'some avg10' >= this % (other tenants are starving)
PSI_FILE=/proc/pressure/cpu    # inside a container point this at the HOST's pressure (a container sees its own)
PSI_MAX_AGE=120                # a PSI_FILE older than this counts as unknown: no emergency park
LADDER=0                       # throttle ladder: 0 = off, observe = log levels only, enforce (see README)
LADDER_PSI_FILE=/run/mari-gate/wing-cpu-pressure   # 'some avg10=<max>' of the tenants to protect (wing-psi.sh on the host)
LADDER_CGROUP=/sys/fs/cgroup/system.slice          # holds dockerd, BuildKit and every container
LADDER_T1=10; LADDER_T2=15; LADDER_T3=25           # enter L1/L2/L3 at >= these % ...
LADDER_N1=3;  LADDER_N2=5;  LADDER_N3=10           # ... for this many ticks in a row
LADDER_CALM=5                  # step down one level after this many ticks below the level's threshold
LADDER_CPU2="400000 100000"    # cpu.max at L2 (4 CPUs)
LADDER_CPU3="200000 100000"    # cpu.max at L3 (2 CPUs; never below 2)
LADDER_STALE_S=90              # input older than this never escalates (the level holds)
LADDER_STALE_RESTORE_S=600     # ... and after this long the ladder goes back to L0
LADDER_PARK_AFTER_S=900        # at L3 this long: park one idle runner per tick
